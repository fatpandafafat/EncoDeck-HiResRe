<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="EncoDeck.App.Controls.LhdcSettings"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:EncoDeck.App.Controls">
 <!-- Same layout as the other labs cards: title, codecs, summary, status, message bar, progress, actions, details, disclaimer, help. -->
 <Border Style="{StaticResource CardStyle}">
  <StackPanel Spacing="10">
   <TextBlock x:Uid="Lhdc_Title" Style="{StaticResource BodyStrongTextBlockStyle}" />
   <!-- Codecs, as the home page tags them; outlined ones are experimental upstream. -->
   <local:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" x:Uid="Lhdc_Codecs">
    <Border Style="{StaticResource CodecBadgeStyle}"><TextBlock Text="LHDC V5" Style="{StaticResource CodecBadgeTextStyle}" /></Border>
   </local:WrapPanel>
   <TextBlock x:Uid="Lhdc_Summary" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
   <TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
   <!-- The deployment stages, while the elevated script runs. -->
   <StackPanel x:Name="DeployProgressPanel" Spacing="4" Visibility="Collapsed">
    <ProgressBar x:Name="DeployProgress" IsIndeterminate="True" />
    <TextBlock x:Name="DeployStage" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
   </StackPanel>
   <InfoBar x:Name="Notice" IsOpen="False" Visibility="Collapsed" />
   <HyperlinkButton x:Name="StandaloneLink" x:Uid="Lhdc_StandaloneLink" NavigateUri="https://github.com/fatpandafafat/EncoDeck-HiResRe/releases/latest" Visibility="Collapsed" Padding="0" />
   <ProgressBar x:Name="Progress" Visibility="Collapsed" Maximum="100" />
   <local:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
    <Button x:Name="Download" Click="OnDownload" Style="{StaticResource AccentButtonStyle}" />
    <Button x:Name="Cancel" Click="OnCancel" Visibility="Collapsed" />
    <Button x:Name="CheckUpdates" Click="OnCheckUpdates" Visibility="Collapsed" />
    <Button x:Name="Uninstall" Click="OnUninstall" Visibility="Collapsed" />
   </local:WrapPanel>
   <StackPanel x:Name="Editor" Spacing="10" Visibility="Collapsed">
    <ComboBox x:Name="Devices" HorizontalAlignment="Stretch" DisplayMemberPath="Label" SelectionChanged="OnDeviceChanged" />
    <!-- Ear-side switch: it decides which sample rates and bitrates the earbud advertises to
         Windows, so it has to be on before anything above 400 kbps can be applied. -->
    <Grid x:Name="HiResRow" ColumnSpacing="12" Visibility="Collapsed">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Spacing="2">
      <TextBlock x:Uid="Lhdc_HiRes" Style="{StaticResource BodyStrongTextBlockStyle}" />
      <TextBlock x:Name="HiResHint" x:Uid="Lhdc_HiResHint" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
     </StackPanel>
     <ToggleSwitch x:Name="HiRes" Grid.Column="1" Style="{StaticResource TrailingSwitchStyle}" VerticalAlignment="Center" Toggled="OnHiResToggled" />
    </Grid>
    <Grid ColumnSpacing="10">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ComboBox x:Name="Rate" DisplayMemberPath="Label" HorizontalAlignment="Stretch" SelectionChanged="OnRateChanged" />
     <ComboBox x:Name="Depth" Grid.Column="1" DisplayMemberPath="Label" HorizontalAlignment="Stretch" />
     <ComboBox x:Name="Bitrate" Grid.Column="2" DisplayMemberPath="Label" HorizontalAlignment="Stretch" SelectionChanged="OnBitrateChanged" />
    </Grid>
    <CheckBox x:Name="Adaptive" />
    <TextBlock x:Name="Observed" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
    <local:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
     <Button x:Name="Apply" Click="OnApply" Style="{StaticResource AccentButtonStyle}" />
     <Button x:Name="Restore" Click="OnRestore" />
     <Button x:Name="Refresh" Click="OnRefresh" />
    </local:WrapPanel>
   </StackPanel>
   <TextBlock x:Uid="Lhdc_Disclaimer" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
   <Expander x:Uid="Lhdc_Help" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
    <StackPanel Spacing="10">
     <TextBlock x:Uid="Lhdc_HelpRequirements" TextWrapping="Wrap" />
     <TextBlock x:Uid="Lhdc_HelpDownload" TextWrapping="Wrap" />
     <TextBlock x:Uid="Lhdc_HelpApply" TextWrapping="Wrap" />
     <TextBlock x:Uid="Lhdc_HelpQuality" TextWrapping="Wrap" />
     <TextBlock x:Uid="Lhdc_HelpRestore" TextWrapping="Wrap" />
     <HyperlinkButton x:Uid="Lhdc_Guide" NavigateUri="https://github.com/fatpandafafat/EncoDeck-HiResRe/blob/main/docs/LHDC.md" Padding="0" />
    </StackPanel>
   </Expander>
  </StackPanel>
 </Border>
</UserControl>
